{
  "manifest_version": 3,
  "name": "divoomcast",
  "version": "0.1.0",
  "description": "Cast the YouTube video in this tab to a Divoom MiniToo pixel panel.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cast to Divoom",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "128": "icons/128.png" }
}
